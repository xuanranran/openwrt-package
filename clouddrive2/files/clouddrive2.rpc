#!/bin/sh

. /usr/share/libubox/jshn.sh

CLOUDDRIVE_HOME=/etc/CloudDrive2
DEFAULT_HTTP_PORT=19798
PROG=/usr/share/clouddrive2/clouddrive

get_http_port() {
    local http_port

    http_port=$(sed -n 's/^[[:space:]]*http_port[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        "$CLOUDDRIVE_HOME/config.toml" 2>/dev/null | head -n 1)

    case "$http_port" in
        ''|*[!0-9]*) http_port=$DEFAULT_HTTP_PORT ;;
    esac

    printf '%s\n' "$http_port"
}

get_version() {
    local version

    if [ -r "$PROG" ] && command -v strings >/dev/null 2>&1; then
        version=$(strings "$PROG" 2>/dev/null |
            sed -n 's/.*FORCED_VERSION\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | head -n 1)
    fi

    printf '%s\n' "${version:-unknown}"
}

get_architecture() {
    local architecture

    if [ -r /etc/openwrt_release ]; then
        . /etc/openwrt_release
        architecture=$DISTRIB_ARCH
    fi

    printf '%s\n' "${architecture:-$(uname -m)}"
}

get_username() {
    local username

    if command -v jsonfilter >/dev/null 2>&1; then
        username=$(jsonfilter -i "$CLOUDDRIVE_HOME/clouddriveconf.json" \
            -e '@.username' 2>/dev/null)
    fi

    [ "$username" = "null" ] && username=""
    printf '%s\n' "$username"
}

case "$1" in
    list)
        json_init
        json_add_object status
        json_close_object
        json_dump
        json_cleanup
        ;;
    call)
        [ "$2" = "status" ] || exit 1

        username=$(get_username)

        json_init
        if pgrep -x clouddrive >/dev/null 2>&1; then
            json_add_boolean running 1
        else
            json_add_boolean running 0
        fi
        json_add_int port "$(get_http_port)"
        json_add_boolean logged_in "$([ -n "$username" ] && echo 1 || echo 0)"
        json_add_string username "$username"
        json_add_string architecture "$(get_architecture)"
        json_add_string version "$(get_version)"
        json_dump
        json_cleanup
        ;;
esac
