TARGET_CFLAGS := $(filter-out -O%,$(TARGET_CFLAGS)) -O3
TARGET_CXXFLAGS := $(filter-out -O%,$(TARGET_CXXFLAGS)) -O3

CMAKE_OPTIONS += \
	-DCMAKE_INSTALL_PREFIX=/ \
	-DProtobuf_PROTOC_EXECUTABLE=$(STAGING_DIR_HOSTPKG)/bin/protoc \
	-DUSE_LTO=On \
	-DUSE_MOLD=Off \
	-DDEFAULT_FEATURE_STATE=Off \
	-DENABLE_DBENGINE=$(if $(CONFIG_NETDATA_DBENGINE),On,Off) \
	-DENABLE_DASHBOARD=Off \
	-DENABLE_BUNDLED_PROTOBUF=Off \
	-DENABLE_LIBBACKTRACE=Off \
	-DENABLE_LIBUNWIND=$(if $(CONFIG_NETDATA_LIBUNWIND),On,Off) \
	-DENABLE_ML=$(if $(CONFIG_NETDATA_ML),On,Off) \
	-DENABLE_EXPORTER_PROMETHEUS_REMOTE_WRITE=$(if $(CONFIG_NETDATA_PROMETHEUS_REMOTE_WRITE),On,Off) \
	-DENABLE_WEBRTC=$(if $(CONFIG_NETDATA_WEBRTC),On,Off) \
	-DENABLE_CGROUPS_LOOKUP_SERVER=$(if $(CONFIG_NETDATA_CGROUP_LOOKUP),On,Off) \
	-DENABLE_ND_MCP=$(if $(CONFIG_NETDATA_ND_MCP),On,Off) \
	-DENABLE_NETDATA_JOURNAL_FILE_READER=$(if $(CONFIG_PACKAGE_netdata-plugin-systemd-journal),On,Off) \
	-DENABLE_LEGACY_EBPF_PROGRAMS=Off
