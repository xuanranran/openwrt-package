#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

. /lib/functions.sh

state_dir=/var/run/luci-device-access
table=luci_device_access

minutes() {
	local hour minute
	case "$1" in
		[01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) ;;
		*) return 1 ;;
	esac
	hour=${1%:*}
	minute=${1#*:}
	printf '%d\n' "$(( ${hour#0} * 60 + ${minute#0} ))"
}

in_window() {
	local days="$1" start="$2" end="$3"
	if [ "$start" -lt "$end" ]; then
		if [ "$now" -ge "$start" ] && [ "$now" -lt "$end" ]; then
			case " $days " in *" $today "*) return 0 ;; esac
		fi
	else
		if [ "$now" -ge "$start" ]; then
			case " $days " in *" $today "*) return 0 ;; esac
		fi
		if [ "$now" -lt "$end" ]; then
			case " $days " in *" $yesterday "*) return 0 ;; esac
		fi
	fi
	return 1
}

valid_mac() {
	case "$1" in ''|*[!0-9a-fA-F:]*) return 1 ;; esac
	printf '%s\n' "$1" | grep -Eiq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' &&
		[ "$1" != '00:00:00:00:00' ]
}

profile_aliases() {
	local section="$1" mac macs
	config_get macs "$section" macs
	# MAC tokens are validated individually before they reach the nftables plan.
	set -f
	for mac in $macs; do
		valid_mac "$mac" && printf 'alias %s %s\n' "$mac" "$section"
	done
	set +f
}

client_policy() {
	local section="$1" enabled mac mode days start end action
	config_get_bool enabled "$section" enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get mac "$section" mac
	valid_mac "$mac" || return 0
	config_get mode "$section" mode always

	case "$mode" in
		always) action=block ;;
		during|outside)
			config_get days "$section" days
			case "$days" in ''|*[!0-6\ ]*) return 0 ;; esac
			printf '%s\n' "$days" | grep -Eq '^[0-6]( +[0-6])*$' || return 0
			config_get start "$section" start
			config_get end "$section" end
			start=$(minutes "$start") || return 0
			end=$(minutes "$end") || return 0
			[ "$start" -ne "$end" ] || return 0
			if [ "$mode" = during ]; then
				in_window "$days" "$start" "$end" || return 0
				action=block
			elif in_window "$days" "$start" "$end"; then
				action=allow
			else
				action=limit
			fi
			;;
		*) return 0 ;;
	esac
	printf '%s %s\n' "$mac" "$action"
}

render() {
	local clock timezone today yesterday now clients zone devices ports=''
	timezone=$(uci -q get 'system.@system[0].timezone') || timezone=''
	if [ -n "$timezone" ]; then
		clock=$(TZ="$timezone" date '+%w %H:%M') || return 1
	else
		clock=$(date '+%w %H:%M') || return 1
	fi
	today=${clock%% *}
	yesterday=$(( (today + 6) % 7 ))
	now=$(minutes "${clock#* }") || return 1

	config_load device_access || return 1
	clients=$(
		{
			config_foreach profile_aliases client
			config_foreach client_policy device
		} | awk '
			$1 == "alias" {
				mac = tolower($2)
				if (!(mac in groups))
					groups[mac] = $3
				next
			}
			{
				mac = tolower($1)
				group = (mac in groups) ? groups[mac] : mac
				groups[mac] = group
			}
			$2 == "block" { blocked[group] = 1 }
			$2 == "allow" { allowed[group] = 1 }
			$2 == "limit" { limited[group] = 1 }
			END {
				for (mac in groups) {
					group = groups[mac]
					if (blocked[group] || (limited[group] && !allowed[group]))
						print mac
				}
			}' | LC_ALL=C sort | awk '{ printf "%s%s", (NR == 1 ? "" : ", "), $0 }')
	if [ -n "$clients" ]; then
		config_get zone main zone wan
		case "$zone" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
		devices=$(fw4 zone "$zone" 2>/dev/null) || return 1
		ports=$(printf '%s\n' "$devices" | LC_ALL=C sort -u | awk '
			/^[[:alnum:]_.:@+-]+\*?$/ { printf "%s\"%s\"", (count++ ? ", " : ""), $0 }')
	fi

	cat <<EOF
table inet $table
flush table inet $table
table inet $table {
	chain block_wan {
		type filter hook forward priority -10; policy accept;
EOF
	if [ -n "$clients" ] && [ -n "$ports" ]; then
		printf '\t\toifname { %s } ether saddr { %s } counter drop;\n' "$ports" "$clients"
	fi
	printf '\t}\n}\n'
}

refresh_access() {
	local rules old_rules
	rules=$(render) || return 1
	old_rules=$(cat "$state_dir/rules" 2>/dev/null) || old_rules=''
	if [ "$rules" = "$old_rules" ] && nft list table inet "$table" >/dev/null 2>&1; then
		return 0
	fi

	# Replace only this package's table in one nftables transaction.
	printf '%s\n' "$rules" | nft -f - || return 1
	printf '%s\n' "$rules" >"$state_dir/rules"
}

refresh_traffic() {
	ucode /usr/libexec/device-access-traffic.uc
}

refresh() {
	local result=0
	refresh_access || result=1
	refresh_traffic || result=1
	return "$result"
}

clear() {
	local name result=0
	for name in "$table" luci_device_access_traffic; do
		if nft list table inet "$name" >/dev/null 2>&1; then
			nft delete table inet "$name" || result=1
		fi
	done
	rm -f "$state_dir/rules" "$state_dir/traffic" "$state_dir/traffic.new"
	return "$result"
}

locked() (
	flock -x 9 || exit 1
	"$@"
) 9>"$state_dir/lock"

umask 077
mkdir -p "$state_dir" || exit 1
case "$1" in
	refresh) locked refresh ;;
	clear) locked clear ;;
	run)
		trap 'exit 0' INT TERM
		last_minute=
		traffic_ok=1
		while :; do
			now=$(date '+%s') || now=0
			minute=$(( now / 60 ))
			if [ "$minute" != "$last_minute" ]; then
				if locked refresh_access; then
					last_minute=$minute
				else
					echo 'Device Access: could not update access rules' >&2
				fi
			fi
			if locked refresh_traffic; then
				traffic_ok=1
			elif [ "$traffic_ok" = 1 ]; then
				echo 'Device Access: could not update traffic rules' >&2
				traffic_ok=0
			fi
			after=$(date '+%s') || after=$now
			sleep "$(( 5 - after % 5 ))"
		done
		;;
	*) exit 2 ;;
esac
