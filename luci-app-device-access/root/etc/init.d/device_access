#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/device-access run
	procd_set_param file /usr/libexec/device-access /usr/libexec/device-access-traffic.uc \
		/usr/share/ucode/device_access.uc
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	if running; then
		/usr/libexec/device-access refresh
	else
		start
	fi
}

service_stopped() {
	/usr/libexec/device-access clear
}

service_triggers() {
	procd_add_reload_trigger device_access firewall network system
}
