{#
	Argon is a clean HTML5 theme for LuCI. It is based on luci-theme-material Argon Template

	luci-theme-argon
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-argon/issues

	luci-theme-material:
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	Argon Theme
	https://demos.creative-tim.com/argon-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

{%
	import { access } from 'fs';
	import { cursor } from 'uci';
	import { dark_palette, appearance_modes } from 'luci.argon-palette';
	import { srand } from 'math';

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');

	let cfg = cursor();

	//send as HTML5
	http.prepare_content('text/html; charset=UTF-8');

	srand(+substr(reverse(time() + ""), 0, 8));

	function validColor(value, fallback) {
		return type(value) == 'string' && match(value, /^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/) ? value : fallback;
	}

	function validNumber(value, fallback, maximum) {
		return type(value) == 'string' && match(value, /^(0|[1-9][0-9]*)(\.[0-9]+)?$/) && +value <= maximum ? value : fallback;
	}

	let mode = 'normal';
	let primary = '#5e72e4';
	let dark_primary = '#483d8b';
	let blur_radius = '10';
	let blur_radius_dark = '10';
	let blur_opacity = '0.5';
	let blur_opacity_dark = '0.5';
	const has_argon_config = access('/etc/config/argon');
	if (has_argon_config) {
		primary = validColor(cfg.get_first('argon', 'global', 'primary'), primary);
		dark_primary = validColor(cfg.get_first('argon', 'global', 'dark_primary'), dark_primary);
		blur_radius = validNumber(cfg.get_first('argon', 'global', 'blur'), blur_radius, 100);
		blur_radius_dark = validNumber(cfg.get_first('argon', 'global', 'blur_dark'), blur_radius_dark, 100);
		blur_opacity = validNumber(cfg.get_first('argon', 'global', 'transparency'), blur_opacity, 1);
		blur_opacity_dark = validNumber(cfg.get_first('argon', 'global', 'transparency_dark'), blur_opacity_dark, 1);
		let configured_mode = cfg.get_first('argon', 'global', 'mode');
		if (configured_mode == 'normal' || configured_mode == 'dark' || configured_mode == 'light')
			mode = configured_mode;
	}
	// Infer legacy choices without changing any stored custom values.
	let dark_settings = {};
	for (let key in ['dark_primary_mode', 'dark_primary', 'dark_glass_mode', 'blur', 'blur_dark', 'transparency', 'transparency_dark'])
		dark_settings[key] = cfg.get_first('argon', 'global', key);
	const dark_modes = appearance_modes(dark_settings);
	const palette = dark_palette(dark_modes.color == 'custom' ? dark_primary : primary, dark_modes.color == 'custom');
	dark_primary = palette.primary;
	if (dark_modes.glass == 'inherit') {
		blur_radius_dark = blur_radius;
		blur_opacity_dark = blur_opacity;
	}
	const glass_configured = dark_settings.dark_glass_mode == 'inherit' || dark_settings.dark_glass_mode == 'custom';
	const bar_color = mode == 'dark' ? dark_primary : primary;


-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-argon-mode="{{ mode }}" data-argon-color-mode="{{ dark_modes.color }}" data-argon-glass-configured="{{ glass_configured ? 'true' : 'false' }}">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>

	<!-- SEO and Description -->
	<meta name="robots" content="noindex, nofollow">

	<!-- Security -->
	<meta http-equiv="X-Content-Type-Options" content="nosniff">
	<meta http-equiv="X-XSS-Protection" content="1; mode=block">
	<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

	<!-- Mobile and PWA -->
	<meta name="format-detection" content="telephone=no, email=no">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
	<meta name="apple-mobile-web-app-title" content="{{ hostname }} - LuCI">

	<!-- Theme and Colors -->
	{% if (mode == 'normal'): %}
	<meta name="theme-color" media="(prefers-color-scheme: light)" content="{{ primary }}">
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content="{{ dark_primary }}">
	{% else %}
	<meta name="theme-color" content="{{ bar_color }}">
	{% endif %}
	<meta name="msapplication-TileColor" content="{{ bar_color }}">
	<meta name="msapplication-TileImage" content="{{ media }}/icon/ms-icon-144x144.png">
	<meta itemprop="image" content="{{ media }}/icon/android-icon-192x192.png">
	<meta name="application-name" content="{{ hostname }} - LuCI">

	{% include("themes/" + theme + "/branding_icons") %}

	<link rel="stylesheet" href="{{ media }}/css/cascade.css{# ?v=PKG_VERSION #}">
	<link id="argon-dark-stylesheet" rel="stylesheet" href="{{ media }}/css/dark.css" media="{{ mode == 'dark' ? 'all' : mode == 'light' ? 'not all' : '(prefers-color-scheme: dark)' }}">
	<style title="text/css">
		{% if (access('/etc/config/argon')): %}
		:root {
			--primary: {{ primary }};
			--light-primary: {{ primary }};
			--dark-primary: {{ dark_primary }};
			--dark-on-primary: {{ palette.on_primary }};
			--dark-link-color: {{ palette.link }};
			--dark-focus-ring: {{ palette.focus }};
			--dark-control-focus: {{ palette.control_focus }};
			--dark-selected-bg: {{ palette.selected }};
			--dark-selected-hover-bg: {{ palette.hover }};
			--blur-radius:{{ blur_radius }}px;
			--blur-opacity:{{ blur_opacity }};
			--blur-radius-dark:{{ blur_radius_dark }}px;
			--blur-opacity-dark:{{ blur_opacity_dark }};
		}
		{% endif -%}
	</style>
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css}}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}

</head>

<body>
